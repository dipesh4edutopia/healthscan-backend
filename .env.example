# ==============================================================================
# FLASK BACKEND ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Flask environment: development | production
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000

# Secret key for Flask application session signing
SECRET_KEY=change-this-in-production-to-a-very-secure-random-string

# JWT Configuration
# Generate a secure key e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-jwt-secret-in-production-to-a-secure-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
REFRESH_TOKEN_EXPIRES_DAYS=30

# Google OAuth Client IDs (comma-separated if multiple e.g. Web, Android, iOS)
# In development, you can provide your Web Client ID from Google Cloud Console.
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL CONNECTION
# ------------------------------------------------------------------------------
# Recommended: Use the direct connection string from Supabase Dashboard:
# Project Settings -> Database -> Connection string (URI) -> Direct or Pooled
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_SUPABASE_PROJECT_REF.supabase.co:5432/postgres

# Alternatively, set individual connection parameters:
# SUPABASE_DB_HOST=db.YOUR_SUPABASE_PROJECT_REF.supabase.co
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres
# SUPABASE_DB_PASSWORD=YOUR_DB_PASSWORD
# SUPABASE_DB_PORT=5432

# ------------------------------------------------------------------------------
# MULTI-APP CONFIGURATION
# ------------------------------------------------------------------------------
# Default app key if none passed in X-App-Key header or request body
DEFAULT_APP_KEY=main_app

# When a verified Google user signs in for the first time on an app,
# should an active 'user' role entry be automatically created in public.user_app_access?
# True: Seamless onboarding (recommended for public apps)
# False: Whitelist-only (admin must manually grant access first)
AUTO_PROVISION_USER_APP_ACCESS=True

# CORS Allowed Origins (comma-separated, e.g. Expo dev server and production domains)
CORS_ORIGINS=*
